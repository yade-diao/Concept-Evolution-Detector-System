# Copy to .env on the server and fill in. .env is never committed - it holds
# every secret the stack has.
#
#   cp .env.example .env && chmod 600 .env

# The domain this is served on. Caddy asks Let's Encrypt for a certificate for
# exactly this name, so it has to resolve to this server first.
CED_DOMAIN=ced.example.com

# Generate both, do not invent them by hand:
#   openssl rand -base64 48
CED_JWT_SECRET=
CED_DB_PASSWORD=

# The address that becomes the administrator when it registers. Register with
# it on the site once and that account is the administrator - there is no
# endpoint that grants the role, so this file is the only way in.
#
# Leave it blank and the deployment has no administrator: nobody can read the
# feedback, nobody can remove an account, and the notices the server writes are
# addressed to a page no one can open.
CED_ADMIN_EMAIL=

# A mail relay, if there is one. With CED_MAIL_HOST blank the server sends
# nothing: registration is one step with an unverified address, and what would
# have been mail goes to the administrator's inbox in the application, counted
# in the header. Port 587 rather than 25, which Azure blocks outbound.
#
# CED_MAIL_FROM has to be an address the relay is allowed to send as, which for
# every free provider means one you have verified with them.
CED_MAIL_HOST=
CED_MAIL_PORT=587
CED_MAIL_USERNAME=
CED_MAIL_PASSWORD=
CED_MAIL_FROM=

# The database name and user only need changing if something else on this host
# already uses them.
CED_DB_NAME=ced
CED_DB_USER=ced

# Which image to run. The owner is the GitHub account that published it; the tag
# is `latest`, or a commit SHA to pin - `CED_IMAGE_TAG=<sha> docker compose up -d`
# is the whole of a rollback.
CED_IMAGE_OWNER=yade-diao
CED_IMAGE_TAG=latest

# Container memory limits, sized for a 1 GiB machine - which is what every free
# tier worth having turns out to be. Raise them if the machine is bigger; the
# API's heap follows its limit, not the host.
CED_API_MEMORY=640m
CED_DB_MEMORY=256m
CED_PROXY_MEMORY=96m
