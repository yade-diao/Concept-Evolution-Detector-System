# Copy to .env on the server and fill in. .env is never committed - it holds the
# only two secrets the stack has.
#
#   cp .env.example .env && chmod 600 .env

# The domain this is served on. Caddy asks Let's Encrypt for a certificate for
# exactly this name, so it has to resolve to this server first.
CED_DOMAIN=ced.example.com

# Generate both, do not invent them by hand:
#   openssl rand -base64 48
CED_JWT_SECRET=
CED_DB_PASSWORD=

# The database name and user only need changing if something else on this host
# already uses them.
CED_DB_NAME=ced
CED_DB_USER=ced

# Which image to run. The owner is the GitHub account that published it; the tag
# is `latest`, or a commit SHA to pin - `CED_IMAGE_TAG=<sha> docker compose up -d`
# is the whole of a rollback.
CED_IMAGE_OWNER=yade-diao
CED_IMAGE_TAG=latest

# Container memory limits, sized for a 1 GiB machine - which is what every free
# tier worth having turns out to be. Raise them if the machine is bigger; the
# API's heap follows its limit, not the host.
CED_API_MEMORY=640m
CED_DB_MEMORY=256m
CED_PROXY_MEMORY=96m
