# ──────────────────────────────────────────────────
# Python artefacts
# ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# ──────────────────────────────────────────────────
# Editor / IDE
# ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────
# Jupyter notebooks (optional: remove if you want them tracked)
# ──────────────────────────────────────────────────
*.ipynb_checkpoints/

# ──────────────────────────────────────────────────
# Dataset files
# ──────────────────────────────────────────────────
# The eight benchmarks in datasets/bundled are tracked: 23 MB, and having them
# in the repository is what lets CI run the port against the reference on real
# data, and what lets the deployed page fetch them from its own origin. Loose
# .mat files elsewhere are working copies - real_sim alone is 34 MB.
datasets/*.mat
*.mat
!datasets/bundled/*.mat

# ──────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────
*.log
.env

# Maven build output
backend/target/

# ──────────────────────────────────────────────────
# Node
# ──────────────────────────────────────────────────
node_modules/
frontend/dist/
# tsc -b's incremental state, rewritten on every type check.
*.tsbuildinfo
deploy/.env
deploy/site/

# A stale copy left behind when a Windows process held the file open.
backend/pom.locked
